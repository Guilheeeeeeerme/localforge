#!/usr/bin/env bash
set -euo pipefail
ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
cd "$ROOT"
source versions.env
PROFILE_DIR=$(cat .hardware-profile 2>/dev/null || echo "profiles/intel-i7-13620h-rtx3050-6gb-32gb")
die() { echo "error: $*" >&2; exit 1; }
require_python() { command -v python3 >/dev/null || die 'Python 3 is required to update the global OpenCode configuration'; }
compose() { command -v docker >/dev/null || die "Docker is required; run ./llm doctor"; docker compose -p "$COMPOSE_PROJECT_NAME" "$@"; }
profiles() { printf '%s\n' balanced light cpu-safe; }
completion_commands() { printf '%s\n' install init start configure open stop status logs doctor profiles complete clean reinstall uninstall prune; }
completion_options() {
  case "${1:-all}" in
    commands) completion_commands;;
    profiles|start|configure|reinstall) profiles;;
    uninstall) printf '%s\n' --purge --force;;
    all) completion_commands; profiles; printf '%s\n' --purge --force;;
    *) die "unknown completion target '$1'";;
  esac
}
usage() { echo 'Usage: localforge {install|init|start [profile]|configure [profile]|open|stop|status|logs|doctor|profiles|complete|clean|reinstall [profile|--force]|uninstall [--purge --force]|prune}'; }
command_help() {
  case "${1:-}" in
    install) echo 'Usage: localforge install'; echo 'Install LocalForge into ~/.localforge.';;
    init) echo 'Usage: localforge init'; echo 'Create a hardware profile.';;
    start) echo 'Usage: localforge start [profile]'; echo 'Start Ollama and configure the selected model.';;
    configure) echo 'Usage: localforge configure [profile]'; echo 'Configure the selected model in global OpenCode settings.';;
    open) echo 'Usage: localforge open'; echo 'Launch OpenCode.';;
    stop) echo 'Usage: localforge stop'; echo 'Stop LocalForge containers.';;
    status) echo 'Usage: localforge status'; echo 'Show LocalForge container status.';;
    logs) echo 'Usage: localforge logs'; echo 'Follow LocalForge container logs.';;
    doctor) echo 'Usage: localforge doctor'; echo 'Check dependencies and runtime health.';;
    profiles) echo 'Usage: localforge profiles'; echo 'List available hardware profiles.';;
    complete) echo 'Usage: localforge complete [commands|profiles|reasoning|uninstall]'; echo 'Print completion candidates.';;
    clean) echo 'Usage: localforge clean'; echo 'Remove LocalForge containers.';;
    reinstall) echo 'Usage: localforge reinstall [profile|--force]'; echo 'Recreate the runtime and selected model.';;
    uninstall) echo 'Usage: localforge uninstall [--purge] [--force]'; echo 'Remove LocalForge while optionally deleting models.';;
    prune) echo 'Usage: localforge prune'; echo 'Remove stopped containers and orphans.';;
    *) usage;;
  esac
}
resolve_profile() { local p=${1:-balanced}; profiles | grep -Fxq "$p" || die "unknown profile '$p'"; echo "$p"; }
gpu_available() { command -v nvidia-smi >/dev/null && nvidia-smi >/dev/null 2>&1 && docker info 2>/dev/null | grep -qi nvidia; }
doctor() {
  echo "Hardware profile: intel-i7-13620h-rtx3050-6gb-32gb"
  "$ROOT/scripts/detect-hardware.sh" | sed '/HARDWARE_ID=/d'
  command -v docker >/dev/null && echo 'Docker: ok' || echo 'Docker: missing'
  docker compose version >/dev/null 2>&1 && echo 'Compose: ok' || echo 'Compose: missing'
  docker info >/dev/null 2>&1 && echo 'Docker daemon: reachable' || echo 'Docker daemon: unavailable (check service/socket permissions)'
  command -v curl >/dev/null && echo 'curl: ok' || echo 'curl: missing'
  command -v git >/dev/null && echo 'Git: ok' || echo 'Git: missing'
  command -v opencode >/dev/null && echo "OpenCode: $(opencode --version 2>/dev/null | head -1)" || echo 'OpenCode: missing (install before opening a project)'
  gpu_available && echo 'NVIDIA acceleration: available' || echo 'NVIDIA acceleration: unavailable (CPU fallback will be used)'
  echo "Ollama endpoint: http://127.0.0.1:${OLLAMA_PORT}"
}
init_profile() {
  local id="custom-$(hostname | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9-')"
  local dir="profiles/$id"
  [ -e "$dir" ] && die "profile already exists: $dir"
  mkdir -p "$dir"
  cp "$PROFILE_DIR/model.yaml" "$dir/model.yaml"
  cp "$PROFILE_DIR/opencode.json.in" "$dir/opencode.json.in"
  { echo "HARDWARE_ID=$id"; echo 'DEFAULT_PROFILE=balanced'; "$ROOT/scripts/detect-hardware.sh"; } > "$dir/profile.env"
  sed -i "s/intel-i7-13620h-rtx3050-6gb-32gb/$id/g" "$dir/model.yaml"
  printf '%s\n' "$dir" > .hardware-profile
  echo "Created $dir from the current hardware analysis. Review it, then run: ./llm start balanced"
}
start() {
  local p; p=$(resolve_profile "${1:-balanced}"); mkdir -p data/ollama logs
  docker info >/dev/null 2>&1 || die 'Docker daemon is unavailable; run ./llm doctor and start Docker'
  command -v opencode >/dev/null || die 'OpenCode is required; install with: curl -fsSL https://opencode.ai/install | bash'
  local files=(-f compose.yaml); gpu_available && files+=(-f compose.gpu.yaml) && echo 'Using NVIDIA acceleration' || echo 'Using CPU fallback'
  compose "${files[@]}" up -d
  for _ in {1..30}; do curl -fsS "http://127.0.0.1:${OLLAMA_PORT}/api/tags" >/dev/null 2>&1 && break; sleep 2; done
  curl -fsS "http://127.0.0.1:${OLLAMA_PORT}/api/tags" >/dev/null 2>&1 || die 'Ollama did not become healthy; run ./llm logs'
  local model; model=$(awk -v p="$p" '$0 ~ "  " p ":" {found=1} found && /ollama_tag:/ {print $2; exit}' "$PROFILE_DIR/model.yaml")
  [ -n "$model" ] || die "no model configured for $p"
  compose "${files[@]}" exec -T ollama ollama pull "$model"
  configure_opencode "$p" "$model"
  echo "Started $model ($p). OpenCode is configured; run './llm open' or 'opencode'."
}
configure_opencode() {
  local p=${1:-balanced} model=${2:-}
  [ -n "$model" ] || model=$(awk -v p="$p" '$0 ~ "  " p ":" {found=1} found && /ollama_tag:/ {print $2; exit}' "$PROFILE_DIR/model.yaml")
  [ -n "$model" ] || die "no model configured for $p"
  sed "s/__MODEL__/$model/g; s/__PROFILE__/$p/g" "$PROFILE_DIR/opencode.json.in" > opencode.json
  require_python
  local reasoning_variants
  reasoning_variants=$(awk -v p="$p" '$0 ~ "  " p ":" {inside=1; next} inside && /^  [a-z0-9-]+:/ {exit} inside && /reasoning_variants:/ {sub(/.*reasoning_variants:[[:space:]]*/, ""); print; exit}' "$PROFILE_DIR/model.yaml")
  python3 "$ROOT/scripts/opencode_config.py" apply --model "$model" --profile "$p" --base-url "http://127.0.0.1:${OLLAMA_PORT}/v1" --reasoning-variants "$reasoning_variants"
}
open_opencode() {
  command -v opencode >/dev/null || die 'OpenCode is required; install with: curl -fsSL https://opencode.ai/install | bash'
  [ -f opencode.json ] || die "OpenCode is not configured; run './llm start' or './llm configure'"
  exec opencode
}
reinstall() {
  local p=${1:-balanced}
  if [ "$p" = "--force" ]; then
    p=${2:-balanced}
    uninstall --purge --force
  fi
  compose down
  compose pull
  start "$p"
}
uninstall() {
  local purge=false force=false arg
  for arg in "$@"; do case "$arg" in --purge) purge=true;; --force) force=true;; esac; done
  if [ "$purge" = true ] && [ "$force" != true ]; then
    read -r -p 'Delete downloaded models in data/ollama? [y/N] ' answer
    [[ "$answer" =~ ^[Yy]$ ]] || die 'uninstall cancelled'
  fi
  compose down --remove-orphans 2>/dev/null || true
  if command -v python3 >/dev/null; then python3 "$ROOT/scripts/opencode_config.py" remove; else echo 'warning: Python 3 is unavailable; LocalForge provider remains in OpenCode config' >&2; fi
  rm -f opencode.json
  if [ "$purge" = true ]; then rm -rf data/ollama; fi
  if [ "$ROOT" = "$HOME/.localforge" ]; then
    rm -f "$HOME/.local/bin/localforge"
    if [ -f "$HOME/.bashrc" ]; then sed -i '/^# >>> localforge >>>$/,/^# <<< localforge <<</d' "$HOME/.bashrc"; fi
    find "$ROOT" -mindepth 1 -maxdepth 1 ! -name data -exec rm -rf -- {} +
  fi
  if [ "$purge" = true ]; then echo 'Uninstalled LocalForge runtime and model data.'; else echo 'Uninstalled LocalForge runtime; model data preserved.'; fi
}
for arg in "$@"; do
  if [ "$arg" = '--help' ]; then command_help "${1:-}"; exit 0; fi
done
case "${1:-}" in
  install) exec "$ROOT/scripts/install.sh" --source "$ROOT";; profiles) profiles;; complete) completion_options "${2:-all}";; doctor) doctor;; init) init_profile;; start) start "${2:-balanced}";; configure) configure_opencode "${2:-balanced}";; open) open_opencode;; stop) compose stop;; status) compose ps;; logs) compose logs -f;; clean) compose down;; reinstall) reinstall "${2:-balanced}";; uninstall) uninstall "${@:2}";; prune) compose down --remove-orphans;; *) usage; exit 2;;
esac
